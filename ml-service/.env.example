# SwasthyaConnect ML service. Example values only; set real ones in the host's dashboard.
ENVIRONMENT=development

# Shared secret; the backend sends it as X-Internal-Token. Must match the backend's ML_SERVICE_TOKEN.
# Required when ENVIRONMENT=production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_SERVICE_TOKEN=

# Folder holding visual_screening.keras, metrics.json and model_validation.json.
MODEL_DIR=./models

# Optional, for hosts without persistent disk: a .zip of the three files above, fetched at startup.
MODEL_BUNDLE_URL=
MODEL_BUNDLE_SHA256=

MAX_UPLOAD_MB=10
