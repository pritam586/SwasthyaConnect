# Vite development proxy target. The local default is http://127.0.0.1:8000.
BACKEND_API_TARGET=http://127.0.0.1:8000

# Optional deployment overrides for a separately hosted API.
# VITE_VISUAL_SCREENING_API_URL=https://api.example.com/api/v1/visual-screening/analyze
# VITE_TRIAGE_API_URL=https://api.example.com/api/v1/triage/assess
# VITE_ABHA_API_URL=https://api.example.com/api/v1/abha/link
# VITE_CLINICAL_WORKFLOW_API_URL=https://api.example.com/api/v1/clinical-workflow/cases

# ── Backend ──
# The FastAPI backend reads these from the process environment; it does not load .env itself.
# Required for any shared deployment; the code has a development-only fallback.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of allowed browser origins; "*" is for local development only.
ALLOWED_ORIGINS=http://localhost:5173
# Optional: SQLite file location (defaults to ui/swasthya_connect.db).
# SWASTHYA_DB_PATH=

# Phone OTP: the dev provider stores codes locally. Set to false in production.
ENABLE_DEV_OTP=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
