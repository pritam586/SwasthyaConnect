# SwasthyaConnect backend API. Example values only: never commit a real .env.
# The app reads the process environment. Locally, export these (or use your IDE's env file
# support); on Render, set them in the service's Environment tab.

# development | production | test. Production refuses insecure settings at startup.
ENVIRONMENT=development

# PostgreSQL in production (Render provides postgres://...; the driver prefix is added automatically).
# Leave empty locally to use backend/swasthya_connect.db (SQLite).
DATABASE_URL=

# At least 32 random characters in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API (the deployed Vercel URL in production).
CORS_ORIGINS=http://localhost:3000

# Internal URL of ml-service and the shared secret it expects. Empty URL = screening unavailable.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=
ML_TIMEOUT_SECONDS=60

# Phone OTP. The development provider returns the code in the API response; it is
# refused in production. Configure Twilio Verify for real SMS.
ENABLE_DEV_OTP=true
REQUIRE_PHONE_VERIFICATION=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Doctor availability windows are interpreted in this timezone.
CLINIC_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=10
AUTH_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Development demo accounts (scripts/seed_demo.py only; never used in production).
DEMO_DOCTOR_PASSWORD=doctor123
DEMO_ADMIN_PASSWORD=admin123
