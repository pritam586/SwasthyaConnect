# SwasthyaConnect frontend (Next.js). Example values only.

# Production (Vercel): the public URL of the backend API on Render. The browser calls it directly,
# so the backend's CORS_ORIGINS must include this site's URL.
NEXT_PUBLIC_API_BASE_URL=

# Local development only, used when NEXT_PUBLIC_API_BASE_URL is empty: /api is proxied here.
BACKEND_URL=http://127.0.0.1:8000
